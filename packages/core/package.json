      "types": "./dist/index.d.ts"
    },
    "./regex": {
      "import": "./dist/detectors/regex.js",
      "types": "./dist/detectors/regex.d.ts"
    },
    "./ner": {
      "import": "./dist/detectors/ner.js",
      "types": "./dist/detectors/ner.d.ts"
    },
    "./parsers": {
      "import": "./dist/parsers/index.js",
      "types": "./dist/parsers/index.d.ts"
    },
    "./masker": {
      "import": "./dist/masker.js",
      "types": "./dist/masker.d.ts"
    },
    "./restorer": {
      "import": "./dist/restorer.js",
      "types": "./dist/restorer.d.ts"
    },
    "./pipeline": {
      "import": "./dist/pipeline.js",
      "types": "./dist/pipeline.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./llm": {
      "import": "./dist/detectors/llm.js",
      "types": "./dist/detectors/llm.d.ts"
    },
    "./orchestrator": {
      "import": "./dist/orchestrator.js",
      "types": "./dist/orchestrator.d.ts"
    },
    "./audit": {
      "import": "./dist/audit.js",
      "types": "./dist/audit.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "echo 'Run tests from root: pnpm test'",
    "test:watch": "vitest --project @redactly/core"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "postal-mime": "^2.7.4",
    "tesseract.js": "^7.0.0"
  }
